{
  "name": "gas-driver",
  "version": "1.0.0",
  "description": "Gas Driver - Ionic React + Vite + Capacitor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode development",
    "build:prod": "NODE_ENV=production tsc -b && vite build --mode production",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:sync:prod": "npm run build:prod && npx cap sync android",
    "cap:android": "npx cap run android",
    "cap:open:android": "npx cap open android",
    "cap:build:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "cap:build:release": "npm run cap:sync:prod && cd android && ./gradlew assembleRelease",
    "postinstall": "node -e \"const fs=require('fs');const f='node_modules/@capacitor/preferences/android/build.gradle';if(fs.existsSync(f)){let c=fs.readFileSync(f,'utf8');c=c.replace(\\\"proguard-android.txt\\\",\\\"proguard-android-optimize.txt\\\");fs.writeFileSync(f,c)}\""
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/preferences": "^8.0.0",
    "@ionic/react": "^8.0.0",
    "@ionic/react-router": "^8.0.0",
    "axios": "^1.7.0",
    "axios-retry": "^4.5.0",
    "ionicons": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "capacitor": {
    "webDir": "dist"
  }
}
