# Gas Driver - Environment Configuration
# Copie este arquivo para .env e ajuste os valores

# API URL (obrigatorio)
# Dispositivo fisico: http://IP_DA_REDE:8000/api (ex: 192.168.10.167)
# Emulador Android: http://10.0.2.2:8000/api
# Producao: https://api.gasautomation.com/api
VITE_API_URL=http://192.168.10.167:8000/api

# EMULADOR Android Studio: usar 10.0.2.2 no lugar do IP
# VITE_API_URL=http://10.0.2.2:8000/api

# Ambiente (development | production)
VITE_ENV=development
